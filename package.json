{
  "name": "MatlabGraderStudentId",
  "private": true,
  "version": "0.1.3",
  "description": "This extension shows student names in Matlab Grader task reports",
  "scripts": {
    "build": "gulp pack --production --vendor=chrome",
    "build:chrome": "gulp pack --production --vendor=chrome",
    "build:firefox": "gulp pack --production --vendor=firefox",
    "build:opera": "gulp pack --production --vendor=opera",
    "build:edge": "gulp pack --production --vendor=edge",
    "dev": "gulp watch --vendor=chrome",
    "start": "npm run dev",
    "lint": "standard app/scripts"
  },
  "standard": {
    "globals": [
      "chrome"
    ]
  },
  "dependencies": {
    "csvtojson": "^2.0.10",
    "sweetalert2": "^9.17.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-loader": "^9.2.1",
    "del": "^8.0.0",
    "gulp": "^5.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-sass": "^6.0.1",
    "gulp-zip": "^6.0.0",
    "sass": "^1.83.4",
    "standard": "^17.1.2",
    "vinyl-named": "^1.1.0",
    "webpack": "^5.97.1",
    "webpack-stream": "^7.0.0",
    "yargs": "^17.7.2"
  }
}
