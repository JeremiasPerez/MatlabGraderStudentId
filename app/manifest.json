{
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "description": "__MSG_appDescription__",
  "version": "0.1.3",
  "manifest_version": 3,
  "default_locale": "en",
  "icons": {
    "16": "images/icon-16.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://egela.ehu.eus/mod/lti/*","https://lms-grader.mathworks.com/v1p1/launch*", "https://learningtool.mathworks.com/v1p3/launch*"],
      "js": ["scripts/content_script.js"],
      "css": ["styles/contentScript.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://egela.ehu.eus/user/index.php*"],
      "js": ["scripts/parseUsers.js"],
      "css": ["styles/parseUsers.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": ["file://*/*"],
  "permissions": [
    "storage",
    "downloads"
  ]
}
